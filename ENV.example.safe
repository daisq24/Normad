# Azure OpenAI
AZURE_OPENAI_KEY=your_openai_key_here
AZURE_OPENAI_ENDPOINT=https://your-openai-endpoint.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=your_model_deployment_name


# Azure AI Search
AZURE_SEARCH_SERVICE=your_search_service_name
AZURE_SEARCH_KEY=your_search_key_here
AZURE_SEARCH_INDEX=your_search_index_name

# Azure CosmosDB for MongoDB
AZURE_COSMOS_CONNECTION_STRING=your_cosmos_connection_string
AZURE_COSMOS_ACCOUNT=your_cosmos_account_name
AZURE_COSMOS_KEY=your_cosmos_key_here
AZURE_COSMOS_DATABASE=your_database_name
AZURE_COSMOS_CONTAINER=your_container_name

# Azure Bot Service
MICROSOFT_APP_ID=your_bot_app_id
MICROSOFT_APP_PASSWORD=your_bot_app_password


# Azure Functions
AZURE_FUNCTION_APP_NAME=your_function_app_name
AZURE_FUNCTION_KEY=your_function_key

# Azure App Service
AZURE_APP_SERVICE_NAME=your_app_service_name

# 应用设置
DEBUG=false
ENVIRONMENT=production 